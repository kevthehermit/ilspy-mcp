# Copy to `.env` and fill in. The server refuses to start without
# MCP_AUTH_TOKEN, and docker compose will refuse to bring the stack up.

# REQUIRED. Bearer token clients must present (used by both the MCP server
# on :8000 and the mcpo OpenAPI front on :8001).
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=replace-me-with-a-long-random-string

# OPTIONAL. Defaults shown — uncomment only to override.
# ILSPY_WORKSPACE=/workspace
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# ILSPYCMD_BIN=/opt/dotnet-tools/ilspycmd
